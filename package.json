{
  "name": "reeferdude-ai-platform",
  "version": "2.0.0",
  "private": true,
  "description": "ReeferDude AI & PotGrowHub Core Platform — Next-generation spatial WebXR, autonomous agentic e-commerce, and AI budtender multi-modal system.",
  "author": "Raymond Meadows <raymond.meadows@reeferdude.com>",
  "license": "MIT",
  "homepage": "https://reeferdude.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeferguyai/gravityless.git"
  },
  "bugs": {
    "url": "https://github.com/reeferguyai/gravityless/issues"
  },
  "keywords": [
    "reeferdude",
    "potgrowhub",
    "ai-budtender",
    "webxr",
    "threejs",
    "ghost-commerce",
    "aeo",
    "seo",
    "nextjs",
    "react",
    "tailwindcss",
    "typescript",
    "spatial-computing",
    "autonomous-agents",
    "zero-inventory",
    "supabasex",
    "graphql",
    "web-audio-api",
    "pwa-offline",
    "structured-data",
    "local-seo",
    "v0-vercel",
    "markdown-engine",
    "quantum-analytics",
    "edge-computing",
    "neural-networks",
    "webassembly",
    "glsl-shaders",
    "vector-embeddings",
    "rag-architecture",
    "multimodal-voice",
    "zero-trust-security",
    "automated-procurement",
    "print-on-demand",
    "organic-growth"
  ],
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "export": "next build && next export",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "agent:procurement": "python3 backend/ghost_procurement_agent.py",
    "agent:seo-audit": "python3 backend/seo_audit_agent.py",
    "agent:neural-sync": "python3 backend/neural_sync_agent.py",
    "agent:security-guard": "python3 backend/security_guard_agent.py",
    "seo:generate-schema": "ts-node scripts/generate-schema.ts",
    "seo:generate-sitemap": "ts-node scripts/generate-sitemap.ts",
    "seo:optimize-assets": "ts-node scripts/optimize-assets.ts",
    "db:migrate": "supabase migration up",
    "db:seed": "ts-node scripts/seed-database.ts",
    "db:reset": "supabase db reset",
    "db:backup": "supabase db dump -f ./database/backups/latest.sql",
    "docker:build": "docker build -t reefer-platform .",
    "docker:run": "docker run -p 3000:3000 reefer-platform",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "clean": "rimraf .next node_modules out coverage dist build",
    "prepare": "husky install",
    "analyze": "ANALYZE=true next build",
    "security:audit": "npm audit --production",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-aspect-ratio": "^1.0.3",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.0.4",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.8",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-toggle-group": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.15.16",
    "@supabase/supabase-js": "^2.39.7",
    "@tanstack/react-query": "^5.20.0",
    "@tanstack/react-table": "^8.13.0",
    "canvas-confetti": "^1.9.2",
    "clsx": "^2.1.0",
    "cmdk": "^0.2.1",
    "date-fns": "^3.3.1",
    "framer-motion": "^11.0.5",
    "lucide-react": "^0.330.0",
    "next": "^14.1.0",
    "next-seo": "^6.4.0",
    "next-themes": "^0.2.1",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.50.1",
    "recharts": "^2.12.0",
    "schema-dts": "^1.1.2",
    "sonner": "^1.4.0",
    "tailwind-merge": "^2.2.1",
    "three": "^0.161.0",
    "three-stdlib": "^2.29.4",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.1.0",
    "@playwright/test": "^1.41.2",
    "@supabase/cli": "^1.145.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.11.17",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/three": "^0.161.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.2.2",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "husky": "^9.0.11",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^1.2.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "resolutions": {
    "three": "0.161.0",
    "@types/three": "0.161.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@types/react"
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "publishConfig": {
    "access": "private",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "config": {
    "port": 3000,
    "environment": "production"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
