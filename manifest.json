{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "name": "ReeferDude — The Universal Socket & AI Platform",
  "short_name": "ReeferDude",
  "description": "Next-generation spatial WebXR, AI Budtender, zero-inventory Ghost Commerce, and educational grow platform.",
  "id": "com.reeferdude.app",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#0A0A0A",
  "theme_color": "#00D26A",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "lifestyle",
    "utilities",
    "education",
    "shopping",
    "entertainment",
    "business",
    "finance",
    "productivity",
    "social",
    "graphics"
  ],
  "prefer_related_applications": false,
  "iarc_rating_id": "e84b3b5e-188b-4b2e-a123-reeferdude2026",
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
